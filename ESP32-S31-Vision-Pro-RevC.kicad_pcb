	(gr_text "FABRICATION NOTES - ESP32-S31 VISION PRO  Rev C (single-sided SMT assembly)"
		(at 164 61 0)
		(layer "User.2")
		(uuid "083e33a4-0e67-43d3-b69d-e15801328fb2")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "1. 4 layers, 1.6 mm FR4. JLC stackup: F.Cu 35um / 7628 prepreg 0.2104 / In1 GND / core 1.065 / In2 +3V3_SYS / 7628 prepreg 0.2104 / B.Cu 35um."
		(at 164 62.4 0)
		(layer "User.2")
		(uuid "519ddad6-10f0-46be-96ea-4f2ef5701849")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "2. Surface finish: HASL (with lead) is acceptable. LPI solder mask both sides. Silkscreen white."
		(at 164 63.8 0)
		(layer "User.2")
		(uuid "4ab99e68-8a8b-46ac-8a63-1d69f40f1363")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "3. Controlled impedance (er 4.4, 0.2104 mm to In1 GND): USB_DP/DN 90 ohm diff 0.26/0.15 mm; 4-bit SDIO + DVP camera bus 50 ohm SE 0.35 mm (necked at pads)."
		(at 164 65.2 0)
		(layer "User.2")
		(uuid "9fc8e8d1-b82d-4d4c-9c67-01ddf7dd5113")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "4. Vias 0.45/0.20 mm tented; thermal vias 0.50/0.30 mm tented under U1 (BQ24075), at U2 (TPS63802) GND/AGND and in the module ground pad."
		(at 164 66.599999 0)
		(layer "User.2")
		(uuid "6a3e6b8d-0df8-4448-8e42-cbc18cdc716d")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "5. Anti-tamper: TAMPER_LOOP is a continuous 0.15 mm perimeter trace weaving F.Cu/B.Cu, >= 0.3 mm from edges, pours and the M2.5 hole pads. Do not modify."
		(at 164 68 0)
		(layer "User.2")
		(uuid "cdf67dcf-68db-497f-8195-910202604abc")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "6. RF: no copper on any layer inside the 'RF keep-out' rule area under the module RF/U.FL band; GND via fence around it."
		(at 164 69.4 0)
		(layer "User.2")
		(uuid "0f3a00e4-9fbc-4298-a77c-20c4a4ab58b3")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "7. Assembly: all SMT parts on TOP. J3 (I2C header) is DNP. Test pads TP1-TP10 and the M2.5 hole pads are bare copper."
		(at 164 70.8 0)
		(layer "User.2")
		(uuid "ecc1db68-7b04-4320-b146-9aeae9aa8fb7")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "8. Conformal coating: mask every area drawn on User.1 (Conformal.Keepout) and its dashed silkscreen border."
		(at 164 72.2 0)
		(layer "User.2")
		(uuid "34ee3a9d-aeff-4a1b-bbd1-38e61761890e")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
	(gr_text "9. Board 60.0 x 58.0 mm, corner radius 2.0 mm. 4 x M2.5 plated via-stitched mounting holes tied to GND."
		(at 164 73.6 0)
		(layer "User.2")
		(uuid "2ee6d80c-c447-4bd8-92ef-ebb4f51552a0")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
			(justify left)
		)
	)
