	(text "Rev C chord power-on: SW_L + SW_R in series (VSYS -> WAKE_MID -> WAKE), Schottky diode-OR (TMR_OUT | WAKE | HOLD) -> EN_TPS, sense dividers"
		(exclude_from_sim no)
		(at 154.94 159.48 0)
		(effects
			(font
